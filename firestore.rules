rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.preferredLanguage is string && data.preferredLanguage.size() <= 15 &&
             (!('languageMode' in data) || (data.languageMode is string && data.languageMode.size() <= 20)) &&
             (!('state' in data) || (data.state is string && data.state.size() <= 100)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
             (!('locationConsent' in data) || data.locationConsent is bool) &&
             (!('primaryCrops' in data) || (data.primaryCrops is list && data.primaryCrops.size() <= 20)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidCropScan(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.cropName is string && data.cropName.size() >= 1 && data.cropName.size() <= 100 &&
             (!('cropStage' in data) || (data.cropStage is string && data.cropStage.size() <= 50)) &&
             (!('symptomsDescription' in data) || (data.symptomsDescription is string && data.symptomsDescription.size() <= 2000)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
             (!('photoUri' in data) || (data.photoUri is string && data.photoUri.size() <= 500000)) &&
             (!('visibleSymptoms' in data) || (data.visibleSymptoms is list && data.visibleSymptoms.size() <= 50)) &&
             (!('possibleCauses' in data) || (data.possibleCauses is list && data.possibleCauses.size() <= 50)) &&
             (!('uncertaintyLevel' in data) || (data.uncertaintyLevel is string && data.uncertaintyLevel.size() <= 30)) &&
             (!('missingInformation' in data) || (data.missingInformation is list && data.missingInformation.size() <= 50)) &&
             (!('safeNextSteps' in data) || (data.safeNextSteps is list && data.safeNextSteps.size() <= 50)) &&
             (!('expertReferralRequired' in data) || data.expertReferralRequired is bool) &&
             (!('disclaimer' in data) || (data.disclaimer is string && data.disclaimer.size() <= 2000)) &&
             (!('language' in data) || (data.language is string && data.language.size() <= 10)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidFollowUpScan(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.scanId is string && data.scanId.size() <= 128 &&
             data.cropName is string && data.cropName.size() >= 1 && data.cropName.size() <= 100 &&
             (!('previousPhotoUri' in data) || (data.previousPhotoUri is string && data.previousPhotoUri.size() <= 500000)) &&
             (!('currentPhotoUri' in data) || (data.currentPhotoUri is string && data.currentPhotoUri.size() <= 500000)) &&
             (!('visibleDifferences' in data) || (data.visibleDifferences is list && data.visibleDifferences.size() <= 50)) &&
             (!('updatedObservations' in data) || (data.updatedObservations is string && data.updatedObservations.size() <= 3000)) &&
             (!('suggestedNextSteps' in data) || (data.suggestedNextSteps is list && data.suggestedNextSteps.size() <= 50)) &&
             (!('farmerNotes' in data) || (data.farmerNotes is string && data.farmerNotes.size() <= 2000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // User Profile
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLanguage', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'preferredLanguage', 'languageMode', 'state', 'district', 'locationConsent', 'primaryCrops', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'languageMode', 'state', 'district', 'locationConsent', 'primaryCrops', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Crop Health Scans
      match /scans/{scanId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'cropName', 'createdAt']) &&
                         incoming().keys().hasOnly([
                           'userId', 'cropName', 'cropStage', 'symptomsDescription', 'district',
                           'photoUri', 'visibleSymptoms', 'possibleCauses', 'uncertaintyLevel',
                           'missingInformation', 'safeNextSteps', 'expertReferralRequired',
                           'disclaimer', 'language', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCropScan(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidCropScan(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'cropStage', 'symptomsDescription', 'district', 'photoUri',
                           'visibleSymptoms', 'possibleCauses', 'uncertaintyLevel',
                           'missingInformation', 'safeNextSteps', 'expertReferralRequired',
                           'disclaimer', 'language', 'notes', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Follow-Up Scans
      match /follow_ups/{followUpId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'scanId', 'cropName', 'createdAt']) &&
                         incoming().keys().hasOnly([
                           'userId', 'scanId', 'cropName', 'previousPhotoUri', 'currentPhotoUri',
                           'visibleDifferences', 'updatedObservations', 'suggestedNextSteps',
                           'farmerNotes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidFollowUpScan(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidFollowUpScan(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'currentPhotoUri', 'visibleDifferences', 'updatedObservations',
                           'suggestedNextSteps', 'farmerNotes', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
